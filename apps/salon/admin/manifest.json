      "roles": [
        "admin"
      ]
    },
    {
      "key": "staffdisc",
      "label": "Staff discounts",
      "screen": "resource",
      "resource": "staffDiscounts",
      "roles": [
        "admin"
      ]
    },
    {
      "key": "audit",
      "label": "Activity log",
      "screen": "resource",
      "resource": "audit",
      "roles": [
        "admin"
      ]
    }
  ],
  "stats": {
    "today": {
      "label": "Today",
      "endpoint": "/summary/today",
      "refreshMs": 120000,
      "cards": [
        {
          "label": "Bookings today",
          "path": "bookings.today",
          "type": "number"
        },
        {
          "label": "Waiting for you",
          "path": "bookings.pending",
          "type": "number"
        },
        {
          "label": "Sales yesterday",
          "path": "sales.yesterday",
          "type": "money"
        },
        {
          "label": "Sales today",
          "path": "sales.today",
          "type": "money"
        }
      ],
      "tables": [
        {
          "label": "Three things to do today (suggestions, nothing is sent)",
          "rows": "actions",
          "empty": "All clear.",
          "columns": [
            {
              "key": "title",
              "label": "What"
            },
            {
              "key": "reason",
              "label": "Why"
            },
            {
              "key": "count",
              "label": "How many",
              "type": "number"
            }
          ]
        }
      ]
    },
    "alerts": {
      "label": "Things to look at (not accusations)",
      "endpoint": "/alerts",
      "tables": [
        {
          "label": "Leak checks, last 30 days",
          "rows": "items",
          "empty": "Nothing unusual.",
          "columns": [
            {
              "key": "text",
              "label": "What"
            },
            {
              "key": "kind",
              "label": "Type",
              "type": "pill"
            }
          ]
        }
      ]
    },
    "accounts": {
      "label": "Accounts this month",
      "endpoint": "/accounts/month",
      "refreshMs": 300000,
      "cards": [
        {
          "label": "Sales (before GST)",
          "path": "income",
          "type": "money"
        },
        {
          "label": "Staff commission",
          "path": "commission",
          "type": "money"
        },
        {
          "label": "Expenses",
          "path": "expenseTotal",
          "type": "money"
        },
        {
          "label": "Profit",
          "path": "profit",
          "type": "money"
        },
        {
          "label": "Discounts given",
          "path": "discountsGiven",
          "type": "money"
        },
        {
          "label": "GST collected",
          "path": "gst.gst",
          "type": "money"
        }
      ],
      "tables": [
        {
          "label": "In plain words",
          "rows": "textRows",
          "empty": "",
          "columns": [
            {
              "key": "text",
              "label": ""
            }
          ]
        },
        {
          "label": "Expenses by type",
          "rows": "categories",
          "empty": "No expenses this month.",
          "columns": [
            {
              "key": "category",
              "label": "Type"
            },
            {
              "key": "amount",
              "label": "Amount",
              "type": "money"
            }
          ]
        },
        {
          "label": "GST by rate (for your CA; we do not file GST)",
          "rows": "gstRates",
          "empty": "No GST this month.",
          "columns": [
            {
              "key": "rate",
              "label": "Rate %",
              "type": "number"
            },
            {
              "key": "taxable",
              "label": "Sales",
              "type": "money"
            },
            {
              "key": "gst",
              "label": "GST",
              "type": "money"
            }
          ]
        },
        {
          "label": "Bills you still have to pay",
          "rows": "supplierDues",
          "empty": "Nothing due.",
          "columns": [
            {
              "key": "paidTo",
              "label": "To"
            },
            {
              "key": "category",
              "label": "Type"
            },
            {
              "key": "amount",
              "label": "Amount",
              "type": "money"
            },
            {
              "key": "dueDate",
              "label": "Due",
              "type": "date"
            }
          ]
        }
      ]
    }
  },
  "resources": {
    "appointments": {
      "label": "Appointments (today)",
      "endpoint": "/appointments",
      "empty": "No visits today.",
      "columns": [
        {
          "key": "start",
          "label": "Start (minutes)",
          "type": "number"
        },
        {
          "key": "serviceName",
          "label": "Service"
        },
        {
          "key": "status",
          "label": "Status",
          "type": "pill"
        },
        {
          "key": "source",
          "label": "How booked",
          "type": "pill"
        }
      ],
      "actions": [
        {
          "label": "Done",
          "method": "POST",
          "path": "/appointments/:id/done",
          "when": {
            "key": "status",
            "equals": "booked"
          }
        },
        {
          "label": "No-show",
          "method": "POST",
          "path": "/appointments/:id/noshow",
          "when": {
            "key": "status",
            "equals": "booked"
          }
        },
        {
          "label": "Accept",
          "method": "POST",
          "path": "/appointments/:id/accept",
          "when": {
            "key": "status",
            "equals": "pending"
          }
        },
        {
          "label": "Cancel",
          "method": "POST",
          "path": "/appointments/:id/cancel",
          "when": {
            "key": "status",
            "equals": "booked"
          }
        }
      ]
    },
    "customers": {
      "label": "Customers",
      "endpoint": "/customers",
      "empty": "No customers yet.",
      "columns": [
        {
          "key": "name",
          "label": "Name"
        },
        {
          "key": "phone",
          "label": "Phone"
        },
        {
          "key": "lastVisit",
          "label": "Last visit",
          "type": "date"
        }
      ],
      "fields": [
        {
          "key": "name",
          "label": "Name",
          "required": true,
          "max": 120
        },
        {
          "key": "phone",
          "label": "Mobile number",
          "required": true,
          "max": 15
        },
        {
          "key": "consentGiven",
          "label": "Customer agreed to be contacted",
          "type": "bool"
        }
      ]
    },
    "services": {
      "label": "Services",
      "endpoint": "/services",
      "empty": "Add your first service.",
      "columns": [
        {
          "key": "name",
          "label": "Service"
        },
        {
          "key": "mins",
          "label": "Minutes",
          "type": "number"
        },
        {
          "key": "price",
          "label": "Price (Rs)",
          "type": "number"
        },
        {
          "key": "isActive",
          "label": "On",
          "type": "bool"
        }
      ],
      "fields": [
        {
          "key": "name",
          "label": "Service name",
          "required": true,
          "max": 80
        },
        {
          "key": "mins",
          "label": "Minutes",
          "type": "number",
          "required": true
        },
        {
          "key": "price",
          "label": "Price in whole rupees",
          "type": "number"
        }
      ]
    },
    "staff": {
      "label": "Staff (no limit)",
      "endpoint": "/staff",
      "empty": "Add your first staff member.",
      "columns": [
        {
          "key": "name",
          "label": "Name"
        },
        {
          "key": "isActive",
          "label": "Active",
          "type": "bool"
        }
      ],
      "fields": [
        {
          "key": "name",
          "label": "Name",
          "required": true,
          "max": 80
        },
        {
          "key": "email",
          "label": "Login email (optional)",
          "max": 120
        },
        {
          "key": "password",
          "label": "Login password (10+ characters, optional)",
          "max": 100
        }
      ]
    },
    "bills": {
      "label": "Bills",
      "endpoint": "/bills",
      "readOnly": true,
      "empty": "No bills yet.",
      "columns": [
        {
          "key": "number",
          "label": "Bill"
        },
        {
          "key": "date",
          "label": "Date",
          "type": "date"
        },
        {
          "key": "total",
          "label": "Total (Rs)",
          "type": "number"
        },
        {
          "key": "status",
          "label": "Payment",
          "type": "pill"
        }
      ]
    },
    "expenses": {
      "label": "Expenses (last 60 days)",
      "endpoint": "/expenses",
      "empty": "No expenses yet.",
      "columns": [
        {
          "key": "date",
          "label": "Date",
          "type": "date"
        },
        {
          "key": "category",
          "label": "Type",
          "type": "pill"
        },
        {
          "key": "amount",
          "label": "Amount",
          "type": "money"
        },
        {
          "key": "paidTo",
          "label": "Paid to"
        },
        {
          "key": "paid",
          "label": "Paid",
          "type": "bool"
        }
      ],
      "fields": [
        {
          "key": "amount",
          "label": "Amount (rupees)",
          "type": "money",
          "required": true
        },
        {
          "key": "category",
          "label": "Type",
          "type": "select",
          "options": [
            {
              "value": "rent",
              "label": "rent"
            },
            {
              "value": "salary",
              "label": "salary"
            },
            {
              "value": "products",
              "label": "products"
            },
            {
              "value": "electricity",
              "label": "electricity"
            },
            {
              "value": "marketing",
              "label": "marketing"
            },
            {
              "value": "repairs",
              "label": "repairs"
            },
            {
              "value": "other",
              "label": "other"
            }
          ]
        },
        {
          "key": "paidTo",
          "label": "Paid to",
          "type": "text"
        },
        {
          "key": "date",
          "label": "Date",
          "type": "date"
        }
      ],
      "actions": [
        {
          "label": "Mark paid",
          "method": "POST",
          "path": "/expenses/:id/paid",
          "when": {
            "key": "paid",
            "equals": false
          }
        }
      ]
    },
    "staffDiscounts": {
      "label": "Discounts your staff gave (last 60 days)",
      "endpoint": "/discounts/staff",
      "readOnly": true,
      "empty": "No staff discounts.",
      "columns": [
        {
          "key": "date",
          "label": "Date",
          "type": "date"
        },
        {
          "key": "number",
          "label": "Bill"
        },
        {
          "key": "discount",
          "label": "Rupees off",
          "type": "money"
        },
        {
          "key": "percent",
          "label": "Percent",
          "type": "number"
        },
        {
          "key": "reason",
          "label": "Reason"
        }
      ]
    },
    "audit": {
      "label": "Activity log (what was done, by whom)",
      "endpoint": "/audit",
      "readOnly": true,
      "empty": "Nothing yet.",
      "columns": [
        {
          "key": "at",
          "label": "When",
          "type": "date"
        },
        {
          "key": "action",
          "label": "What"
        },
        {
          "key": "ref",
          "label": "Ref"
        }
      ]
    }
  },
  "settings": {
    "discount": {
      "label": "Discounts",
      "endpoint": "/settings",
      "intro": "You decide who may give a discount. Every discount needs a reason, and you always see the ones your staff give in your daily list. You are never limited yourself.",
      "fields": [
        {
          "key": "discountRule.staff",
          "label": "Who may give a discount at billing?",
          "type": "select",
          "default": "limit",
          "options": [
            {
              "value": "limit",
              "label": "Staff, up to a limit"
            },
            {
              "value": "owner_only",
              "label": "Only me (the owner)"
            },
            {
              "value": "any",
              "label": "Any staff, any amount"
            }
          ]
        },
        {
          "key": "discountRule.maxPercent",
          "label": "Staff limit (percent of the bill)",
          "type": "number",
          "min": 0,
          "max": 100,
          "default": 10,
          "showWhen": {
            "key": "discountRule.staff",
            "equals": "limit"
          }
        }
      ]
    }
  }
}