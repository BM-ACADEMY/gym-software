  "stats": {
    "today": {
      "label": "Yesterday and today's three jobs",
      "endpoint": "/summary",
      "refreshMs": 300000,
      "cards": [
        {
          "label": "Sales",
          "path": "sales.total",
          "type": "money"
        },
        {
          "label": "Bills",
          "path": "sales.count",
          "type": "number"
        },
        {
          "label": "Cash",
          "path": "sales.cash",
          "type": "money"
        },
        {
          "label": "UPI",
          "path": "sales.upi",
          "type": "money"
        },
        {
          "label": "Udhaar overdue",
          "path": "udhaarOverdueTotal",
          "type": "money"
        },
        {
          "label": "Low stock items",
          "path": "lowStockCount",
          "type": "number"
        }
      ],
      "tables": [
        {
          "label": "Three things to do today (suggestions)",
          "rows": "actions",
          "empty": "Nothing needs you today.",
          "columns": [
            {
              "key": "text",
              "label": "What"
            },
            {
              "key": "reason",
              "label": "Why"
            },
            {
              "key": "rupees",
              "label": "At stake",
              "type": "money"
            }
          ]
        }
      ]
    },
    "udhaar": {
      "label": "Udhaar (pay later)",
      "endpoint": "/udhaar",
      "cards": [
        {
          "label": "Total owed",
          "path": "totalDue",
          "type": "money"
        }
      ],
      "tables": [
        {
          "label": "Overdue",
          "rows": "overdue",
          "empty": "Nobody is overdue.",
          "columns": [
            {
              "key": "name",
              "label": "Customer"
            },
            {
              "key": "phone",
              "label": "Phone",
              "type": "phone"
            },
            {
              "key": "due",
              "label": "Owes",
              "type": "money"
            },
            {
              "key": "daysOld",
              "label": "Days old",
              "type": "number"
            }
          ]
        },
        {
          "label": "Everyone who owes",
          "rows": "owing",
          "empty": "No udhaar.",
          "columns": [
            {
              "key": "name",
              "label": "Customer"
            },
            {
              "key": "due",
              "label": "Owes",
              "type": "money"
            }
          ]
        }
      ]
    },
    "reorder": {
      "label": "Order list (suggestions)",
      "endpoint": "/reports/reorder",
      "tables": [
        {
          "label": "Running low, with the reason",
          "rows": "",
          "empty": "Nothing needs ordering.",
          "columns": [
            {
              "key": "name",
              "label": "Item"
            },
            {
              "key": "qty",
              "label": "Left",
              "type": "number"
            },
            {
              "key": "daysLeft",
              "label": "Days left",
              "type": "number"
            },
            {
              "key": "orderQty",
              "label": "Order",
              "type": "number"
            },
            {
              "key": "reason",
              "label": "Why"
            }
          ]
        }
      ]
    },
    "expiry": {
      "label": "Expiry",
      "endpoint": "/reports/expiry",
      "tables": [
        {
          "label": "Expiring within 30 days",
          "rows": "",
          "empty": "Nothing expires soon.",
          "columns": [
            {
              "key": "name",
              "label": "Item"
            },
            {
              "key": "daysLeft",
              "label": "Days left",
              "type": "number"
            },
            {
              "key": "suggestedDiscountPct",
