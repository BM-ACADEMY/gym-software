          "showWhen": {
            "key": "discountRule.staff",
            "equals": "limit"
          }
        },
        {
          "key": "clearCreditLimit",
          "label": "Remove the udhaar limit (leave the number above empty)",
          "type": "bool"
        },
        {
          "key": "upiId",
          "label": "Your UPI id (for payment links)",
          "type": "text",
          "max": 80
        },
        {
          "key": "upiName",
          "label": "Name shown in the customer's UPI app",
          "type": "text",
          "max": 40
        }
      ],
      "downloads": [
        {
          "label": "Download all my shop data",
          "path": "/privacy/export",
          "filename": "mart-my-data.json"
        }
      ]
    }
  }
