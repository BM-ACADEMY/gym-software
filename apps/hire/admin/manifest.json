    "fees": {
      "label": "Placement fees",
      "endpoint": "/fees",
      "readOnly": true,
      "searchable": false,
      "empty": "No fees yet. A fee is raised after a candidate joins.",
      "columns": [
        {
          "key": "fee",
          "label": "Fee",
          "type": "money"
        },
        {
          "key": "gst",
          "label": "GST",
          "type": "money"
        },
        {
          "key": "total",
          "label": "Total",
          "type": "money"
        },
        {
          "key": "dueDate",
          "label": "Due",
          "type": "date"
        },
        {
          "key": "status",
          "label": "Status",
          "type": "pill"
        }
      ],
      "actions": [
        {
          "label": "Mark paid",
          "method": "POST",
          "path": "/fees/:id/paid",
