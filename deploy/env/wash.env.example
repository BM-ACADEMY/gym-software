# /etc/afraprod/wash.env  (owner afraprod, mode 600, NEVER in git). Variable names only: no values here.
# Written 13 Nov 2026 from the Wash code (grep of env.* in apps/wash/src). REQUIRED = every /api route answers 503 without it.
# PORT and NODE_ENV are set by deploy/ecosystem.config.js.
MONGODB_URI=                   # REQUIRED  Atlas connection string for the Wash database (see deploy/MONGO.md)
WASH_SESSION_SECRET=           # REQUIRED  32+ random characters (shorter and the server stays closed): openssl rand -base64 48
INTERNAL_API_KEY=              # 24+ random characters; without it the Super Admin counts route stays off (401)
WASH_TERMS_VERSION=            # optional, e.g. 2026-11-12; change it to make people accept new terms
WASH_PHOTO_DIR=                # absolute path for job photos on the server disk, e.g. /var/lib/afra/wash-photos (owner afraprod, outside the release folder)
WASH_PUBLIC_URL=               # public https address of the Wash app, used in booking links and QR images
