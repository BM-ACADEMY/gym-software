# /etc/afra/cloth.env  (owner afra, mode 600, NEVER in git). Variable names only: no values here.
# Written 13 Nov 2026 from the Cloth code (grep of env.* in apps/cloth/src). REQUIRED = every /api route answers 503 without it.
# PORT and NODE_ENV are set by deploy/ecosystem.config.js.
MONGODB_URI=                   # REQUIRED  Atlas connection string for the Cloth database (see deploy/MONGO.md)
CLOTH_SESSION_SECRET=           # REQUIRED  32+ random characters (shorter and the server stays closed): openssl rand -base64 48
INTERNAL_API_KEY=              # 24+ random characters; without it the Super Admin counts route stays off (401)
CLOTH_TERMS_VERSION=            # optional, e.g. 2026-11-12; change it to make people accept new terms
