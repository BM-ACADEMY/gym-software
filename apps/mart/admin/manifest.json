  "stats": {
    "today": {
      "label": "Yesterday and today's three jobs",
      "endpoint": "/summary",
      "refreshMs": 300000,
      "cards": [
        {
          "label": "Sales",
          "path": "sales.total",
          "type": "money"
        },
        {
          "label": "Bills",
          "path": "sales.count",
          "type": "number"
        },
        {
          "label": "Cash",
          "path": "sales.cash",
          "type": "money"
        },
        {
          "label": "UPI",
          "path": "sales.upi",
          "type": "money"
        },
        {
          "label": "Udhaar overdue",
          "path": "udhaarOverdueTotal",
          "type": "money"
        },
        {
          "label": "Low stock items",
          "path": "lowStockCount",
          "type": "number"
        }
      ],
      "tables": [
        {
          "label": "Three things to do today (suggestions)",
          "rows": "actions",
          "empty": "Nothing needs you today.",
          "columns": [
            {
              "key": "text",
              "label": "What"
            },
            {
              "key": "reason",
              "label": "Why"
            },
            {
              "key": "rupees",
              "label": "At stake",
              "type": "money"
            }
          ]
        },
        {
          "label": "Discounts given by staff (last 7 days)",
          "rows": "staffDiscounts",
          "empty": "No staff discounts.",
          "columns": [
            {
              "key": "day",
              "label": "Day"
            },
            {
              "key": "count",
              "label": "Count",
              "type": "number"
            },
            {
              "key": "total",
              "label": "Total",
              "type": "money"
            },
            {
              "key": "maxPercent",
              "label": "Largest %",
              "type": "number"
            }
          ]
        }
      ]
    },
    "udhaar": {
      "label": "Udhaar (pay later)",
      "endpoint": "/udhaar",
      "cards": [
        {
          "label": "Total owed",
          "path": "totalDue",
