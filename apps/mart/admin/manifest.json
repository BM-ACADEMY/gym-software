        },
        {
          "key": "overdueGraceDays",
          "label": "Udhaar overdue after (days)",
          "min": 1,
          "max": 365,
          "default": 15
        },
        {
          "key": "discountAlertPct",
          "label": "Warn me when a bill discount is above (%)",
          "min": 5,
          "max": 100,
          "default": 20
        },
        {
          "key": "deadStockDays",
          "label": "Slow stock after (days)",
          "min": 7,
          "max": 365,
          "default": 45
        },
        {
          "key": "festivalUplift",
          "label": "Festival order uplift (1 to 5)",
          "min": 1,
          "max": 5,
          "default": 1
        }
      ],
      "fields": [
        {
          "key": "discountRule.staff",
          "label": "Who may give a discount at billing?",
          "type": "select",
          "default": "limit",
          "options": [
            {
              "value": "limit",
              "label": "Staff, up to a limit"
            },
            {
              "value": "owner_only",
              "label": "Only me (the owner)"
            },
            {
              "value": "any",
              "label": "Any staff, any amount"
            }
          ]
        },
        {
          "key": "discountRule.maxPercent",
          "label": "Staff limit (percent of the bill)",
          "type": "number",
          "min": 0,
          "max": 100,
