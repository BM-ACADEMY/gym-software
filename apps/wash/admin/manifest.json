  "resources": {
    "jobs": {
      "label": "Job board",
      "endpoint": "/jobs",
      "empty": "No open jobs. Add a vehicle that has arrived.",
      "columns": [
        {
          "key": "number",
          "label": "No."
        },
        {
          "key": "plate",
          "label": "Vehicle"
        },
        {
          "key": "bay",
          "label": "Bay"
        },
        {
          "key": "klass",
          "label": "Class"
        },
        {
          "key": "total",
          "label": "Amount",
          "type": "money"
        },
        {
          "key": "state",
          "label": "State",
          "type": "pill"
        }
      ],
      "fields": [
        {
          "key": "plate",
          "label": "Number plate",
          "required": true,
          "max": 15
        },
        {
          "key": "klass",
          "label": "Class",
          "type": "select",
          "options": [
            "bike",
            "hatchback",
            "sedan",
            "suv",
            "other"
          ]
        },
        {
          "key": "bay",
          "label": "Bay (optional, for example Bay 1)",
          "type": "text",
          "max": 12
        }
      ],
      "actions": [
        {
          "label": "Start washing",
          "method": "POST",
          "path": "/jobs/:id/move",
          "body": {
            "to": "washing"
          },
          "when": {
            "key": "state",
            "equals": "waiting"
          }
        },
        {
          "label": "Ready",
          "method": "POST",
          "path": "/jobs/:id/move",
          "body": {
            "to": "ready"
          },
          "when": {
            "key": "state",
            "equals": "washing"
          }
        },
        {
          "label": "Cancel",
          "method": "POST",
          "path": "/jobs/:id/move",
          "body": {
            "to": "cancelled"
          },
          "when": {
            "key": "state",
            "equals": "waiting"
          }
        },
        {
          "label": "Cancel: customer left",
          "method": "POST",
          "path": "/jobs/:id/move",
          "body": {
            "to": "cancelled",
            "reason": "Customer left before the wash finished"
          },
          "when": {
            "key": "state",
            "equals": "washing"
          },
          "confirm": "Tap again to cancel this started job (the owner is told)"
        },
        {
          "label": "Cancel: problem with the vehicle",
          "method": "POST",
          "path": "/jobs/:id/move",
          "body": {
            "to": "cancelled",
            "reason": "Problem found with the vehicle"
          },
          "when": {
            "key": "state",
            "equals": "washing"
          },
          "confirm": "Tap again to cancel this started job (the owner is told)"
        },
        {
          "label": "Cancel: other (owner told)",
          "method": "POST",
          "path": "/jobs/:id/move",
          "body": {
            "to": "cancelled",
            "reason": "Cancelled after washing began, other reason"
          },
          "when": {
            "key": "state",
            "equals": "washing"
          },
          "confirm": "Tap again to cancel this started job (the owner is told)"
        },
        {
          "label": "Delivered, paid cash",
          "method": "POST",
          "path": "/jobs/:id/move",
          "body": {
            "to": "delivered",
            "payAllWith": "cash"
          },
          "when": {
            "key": "state",
            "equals": "ready"
          }
        },
        {
          "label": "Delivered, paid UPI",
          "method": "POST",
          "path": "/jobs/:id/move",
          "body": {
            "to": "delivered",
            "payAllWith": "upi"
          },
          "when": {
            "key": "state",
            "equals": "ready"
          }
        },
        {
          "label": "Delivered, paid card",
          "method": "POST",
          "path": "/jobs/:id/move",
          "body": {
            "to": "delivered",
            "payAllWith": "card"
          },
          "when": {
            "key": "state",
            "equals": "ready"
          }
        }
      ]
    },
