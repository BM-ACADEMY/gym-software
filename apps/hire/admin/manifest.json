          "label": "Expenses",
          "path": "expenses",
          "type": "money"
        },
        {
          "label": "Profit",
          "path": "netProfit",
          "type": "money"
        },
        {
          "label": "Placements paid",
          "path": "placementsPaid",
          "type": "number"
        }
