# /etc/afra/hire.env  (owner afra, mode 600, NEVER in git). Variable names only: no values here.
# Written 13 Nov 2026 from the Hire code (grep of env.* in apps/hire/src). REQUIRED = every /api route answers 503 without it.
# PORT and NODE_ENV are set by deploy/ecosystem.config.js.
MONGODB_URI=                   # REQUIRED  Atlas connection string for the Hire database (see deploy/MONGO.md)
HIRE_SESSION_SECRET=           # REQUIRED  32+ random characters (shorter and the server stays closed): openssl rand -base64 48
INTERNAL_API_KEY=              # 24+ random characters; without it the Super Admin counts route stays off (401)
HIRE_TERMS_VERSION=            # optional, e.g. 2026-11-12; change it to make people accept new terms
HIRE_CONSENT_NOTICE_VERSION=   # optional version label of the candidate consent notice (lawyer to approve the wording)
HIRE_DAILY_AI_BUDGET_INR=      # optional daily AI spend stop in rupees (default 300 in code)
HIRE_AI_RS_PER_MTOK_IN=        # optional price assumptions used to estimate AI cost
HIRE_AI_RS_PER_MTOK_OUT=
