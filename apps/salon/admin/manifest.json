      ]
    },
    {
      "key": "bills",
      "label": "Bills",
      "screen": "resource",
      "resource": "bills",
      "roles": [
        "admin"
      ]
    },
    {
      "key": "alerts",
      "label": "Look at these",
      "screen": "stats",
      "stats": "alerts",
      "roles": [
        "admin"
      ]
    },
    {
      "key": "discount",
      "label": "Discounts",
      "screen": "settings",
      "settings": "discount",
      "roles": [
        "admin"
      ]
    },
    {
      "key": "accounts",
      "label": "Accounts (this month)",
      "screen": "stats",
      "stats": "accounts",
      "roles": [
        "admin"
      ]
    },
    {
      "key": "expenses",
      "label": "Expenses",
      "screen": "resource",
