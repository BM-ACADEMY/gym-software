      "screen": "stats",
      "stats": "today"
    },
    {
      "key": "pipeline",
      "label": "Pipeline",
      "screen": "resource",
      "resource": "entries"
    },
    {
      "key": "candidates",
      "label": "Candidates",
      "screen": "resource",
