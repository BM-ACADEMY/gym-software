  "resources": {
    "appointments": {
      "label": "Appointments (today)",
      "endpoint": "/appointments",
      "empty": "No visits today.",
      "columns": [
        {
          "key": "start",
          "label": "Start (minutes)",
          "type": "number"
        },
        {
          "key": "serviceName",
          "label": "Service"
        },
        {
          "key": "status",
          "label": "Status",
          "type": "pill"
        },
        {
          "key": "source",
          "label": "How booked",
          "type": "pill"
        }
      ],
      "actions": [
        {
          "label": "Done",
          "method": "POST",
          "path": "/appointments/:id/done",
          "when": {
            "key": "status",
            "equals": "booked"
          }
        },
        {
          "label": "No-show",
          "method": "POST",
          "path": "/appointments/:id/noshow",
          "when": {
            "key": "status",
            "equals": "booked"
          }
        },
        {
          "label": "Accept",
          "method": "POST",
          "path": "/appointments/:id/accept",
          "when": {
            "key": "status",
            "equals": "pending"
          }
        },
        {
          "label": "Cancel",
          "method": "POST",
          "path": "/appointments/:id/cancel",
          "when": {
            "key": "status",
            "equals": "booked"
          }
        }
      ]
    },
    "customers": {
      "label": "Customers",
      "endpoint": "/customers",
      "empty": "No customers yet.",
      "columns": [
        {
          "key": "name",
          "label": "Name"
        },
        {
          "key": "phone",
          "label": "Phone"
        },
        {
          "key": "lastVisit",
          "label": "Last visit",
          "type": "date"
        }
      ],
      "fields": [
        {
          "key": "name",
          "label": "Name",
          "required": true,
          "max": 120
        },
        {
          "key": "phone",
          "label": "Mobile number",
          "required": true,
          "max": 15
        },
        {
          "key": "consentGiven",
          "label": "Customer agreed to be contacted",
          "type": "bool"
        }
      ],
      "actions": [
        {
          "label": "Delete on request",
          "method": "POST",
          "path": "/privacy/customers/:id/delete",
          "body": {
            "confirm": "DELETE"
          },
          "confirm": "Tap again: removes name and phone for good",
          "done": "Customer details removed. Bills stay without the name."
        }
      ]
    },
    "services": {
      "label": "Services",
      "endpoint": "/services",
      "empty": "Add your first service.",
      "columns": [
        {
          "key": "name",
          "label": "Service"
        },
        {
          "key": "mins",
          "label": "Minutes",
          "type": "number"
        },
        {
          "key": "price",
          "label": "Price (Rs)",
          "type": "number"
        },
        {
          "key": "isActive",
          "label": "On",
          "type": "bool"
        }
      ],
      "fields": [
        {
          "key": "name",
          "label": "Service name",
          "required": true,
          "max": 80
        },
        {
          "key": "mins",
          "label": "Minutes",
          "type": "number",
          "required": true
        },
        {
          "key": "price",
          "label": "Price in whole rupees",
          "type": "number"
        }
      ]
    },
    "staff": {
      "label": "Staff (no limit)",
      "endpoint": "/staff",
      "empty": "Add your first staff member.",
      "columns": [
        {
          "key": "name",
          "label": "Name"
        },
        {
          "key": "isActive",
          "label": "Active",
          "type": "bool"
        }
      ],
      "fields": [
        {
          "key": "name",
          "label": "Name",
          "required": true,
          "max": 80
        },
        {
          "key": "email",
          "label": "Login email (optional)",
          "max": 120
        },
        {
          "key": "password",
          "label": "Login password (10+ characters, optional)",
          "max": 100
        }
      ]
    },
    "bills": {
      "label": "Bills",
      "endpoint": "/bills",
      "readOnly": true,
      "empty": "No bills yet.",
      "columns": [
        {
          "key": "number",
          "label": "Bill"
        },
        {
          "key": "date",
          "label": "Date",
          "type": "date"
        },
        {
          "key": "total",
          "label": "Total (Rs)",
          "type": "number"
        },
        {
          "key": "status",
          "label": "Payment",
          "type": "pill"
        }
      ],
      "actions": [
        {
          "label": "Void (entered by mistake)",
          "method": "POST",
          "path": "/bills/:id/void",
          "body": {
            "reason": "Entered by mistake"
          },
          "confirm": "Tap again: this bill will not count in your sales",
          "done": "Bill voided.",
          "when": {
            "key": "status",
            "equals": "paid"
          }
        }
      ]
    },
    "expenses": {
      "label": "Expenses (last 60 days)",
      "endpoint": "/expenses",
      "empty": "No expenses yet.",
      "columns": [
        {
          "key": "date",
          "label": "Date",
          "type": "date"
        },
        {
          "key": "category",
          "label": "Type",
          "type": "pill"
        },
        {
          "key": "amount",
          "label": "Amount",
          "type": "money"
        },
        {
          "key": "paidTo",
          "label": "Paid to"
        },
        {
          "key": "paid",
          "label": "Paid",
          "type": "bool"
        }
      ],
      "fields": [
        {
          "key": "amount",
          "label": "Amount (rupees)",
          "type": "money",
          "required": true
        },
        {
          "key": "category",
          "label": "Type",
          "type": "select",
          "options": [
            {
              "value": "rent",
              "label": "rent"
            },
            {
              "value": "salary",
              "label": "salary"
            },
            {
              "value": "products",
              "label": "products"
            },
            {
              "value": "electricity",
              "label": "electricity"
            },
            {
              "value": "marketing",
              "label": "marketing"
            },
            {
              "value": "repairs",
              "label": "repairs"
            },
            {
              "value": "other",
              "label": "other"
            }
          ]
        },
        {
          "key": "paidTo",
          "label": "Paid to",
          "type": "text"
        },
        {
          "key": "date",
          "label": "Date",
          "type": "date"
        }
      ],
      "actions": [
        {
          "label": "Mark paid",
          "method": "POST",
          "path": "/expenses/:id/paid",
          "when": {
            "key": "paid",
            "equals": false
          }
        }
      ]
    },
