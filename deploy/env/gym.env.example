# /etc/afra/gym.env  (owner afra, mode 600, NEVER in git). Variable names only: no values here.
# Written 13 Nov 2026, from server/.env.example and server/server.js. REQUIRED = the server refuses to start in production without it.
# Razorpay keys are NOT here: they are saved in Root Admin > Settings > Payment gateway.
NODE_ENV=production            # REQUIRED (set production)
MONGODB_URI=                   # REQUIRED  Atlas connection string for the GYM database (see deploy/MONGO.md)
JWT_SECRET=                    # REQUIRED  32+ random characters: openssl rand -base64 48
CORS_ORIGINS=                  # REQUIRED in practice  https://fit.afraventures.in
INTERNAL_API_KEY=              # needed for Super Admin counts, 24+ random characters
PUBLIC_SIGNUP=                 # "true" opens public sign-up (closed by default in production)
BULKSMS_API_URL=               # DLT-registered SMS URL with {{phone}} and {{message}}; without it OTP SMS fails
CLIENT_URL=                    # https://fit.afraventures.in
PRODUCT_NAME=
FOUNDER_EMAIL=
RAZORPAY_WEBHOOK_SECRET=       # only if the webhook secret is kept in settings; keys themselves are in Root Admin
WHATSAPP_PHONE_NUMBER_ID=      # after Meta approval
WHATSAPP_ACCESS_TOKEN=         # after Meta approval
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
OPENAI_API_KEY=                # AI features stay off without a key
AI_PROVIDER=                   # openai (default) or openrouter
OPENROUTER_API_KEY=
AI_OPENROUTER_ZDR=
AI_MODEL=
AI_PLAN_MODEL=
AI_REASONING_EFFORT=
AI_DAILY_BUDGET_INR=
USD_INR=
SMTP_HOST=                     # email (founder brief, sign-up, reset); `npm run` checks are in server docs
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SELLER_STATE=                  # company facts for invoices: defaults are in docs/COMPANY_FACTS.md
INVOICE_PREFIX=
INVOICE_SELLER_NAME=
INVOICE_SELLER_GSTIN=
INVOICE_SELLER_PAN=
INVOICE_SELLER_CIN=
INVOICE_SELLER_ADDRESS=
INVOICE_SAC=                   # CA to confirm (M-04)
# PORT is set by deploy/ecosystem.config.js (5000). Do not put MONGODB_TEST_URI on a server.
