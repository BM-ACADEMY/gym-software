              "type": "number"
            },
            {
              "key": "rupees",
              "label": "Stock worth",
              "type": "money"
            }
          ]
        }
      ]
    },
    "profit": {
      "label": "Profit and loss (last 30 days)",
      "endpoint": "/reports/profit-loss",
      "cards": [
        {
          "label": "Sales (no GST)",
          "path": "sales",
          "type": "money"
        },
        {
          "label": "Cost of goods",
          "path": "costOfGoods",
          "type": "money"
        },
        {
          "label": "Expenses",
          "path": "expenses",
          "type": "money"
        },
        {
          "label": "What is left",
          "path": "netProfit",
          "type": "money"
        }
      ],
      "tables": []
    },
    "estimates": {
      "label": "Estimates (not promises)",
      "endpoint": "/reports/forecast",
      "cards": [
        {
          "label": "Next month, low",
          "path": "nextMonth.low",
          "type": "money"
        },
        {
          "label": "Next month, likely",
          "path": "nextMonth.likely",
          "type": "money"
        },
        {
          "label": "Next month, high",
          "path": "nextMonth.high",
          "type": "money"
        },
        {
          "label": "Cash needed for dues",
          "path": "cashNeeded.rupees",
          "type": "money"
        }
      ],
      "tables": [
        {
          "label": "Likely to run out within 7 days",
          "rows": "runOutSoon",
          "empty": "Nothing runs out soon.",
          "columns": [
            {
              "key": "name",
              "label": "Item"
            },
            {
              "key": "daysLeft",
              "label": "Days left",
              "type": "number"
            },
            {
              "key": "reason",
              "label": "Why"
            }
          ]
        }
      ]
    },
    "marketing": {
      "label": "Marketing ideas (suggestions)",
      "endpoint": "/marketing",
      "tables": [
        {
          "label": "Regulars who may be drifting away",
          "rows": "winBack",
          "empty": "No one is drifting right now.",
          "columns": [
            {
              "key": "name",
              "label": "Customer"
            },
            {
              "key": "reason",
              "label": "Why"
            }
          ]
        },
        {
          "label": "Festival offers",
          "rows": "festivals",
          "empty": "Add festival dates in My settings.",
          "columns": [
            {
              "key": "name",
              "label": "Festival"
            },
            {
              "key": "inDays",
              "label": "In days",
              "type": "number"
            },
            {
              "key": "text",
              "label": "Idea"
            }
          ]
        }
      ]
    }
