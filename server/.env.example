PORT=5000
NODE_ENV=production

# MongoDB Atlas connection string (mongodb+srv://...)
MONGODB_URI=
# Separate database for the automated tests; the suite drops it after each run.
# Never point this at your production database.
MONGODB_TEST_URI=

# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated web app origins allowed to call this API in production,
# e.g. https://app.yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=

# In production OTPs are always sent for real (demo mode is ignored).
# Needs a DLT-registered BulkSMS URL containing {{phone}} and {{message}}.
BULKSMS_API_URL=

# Public gym sign-up is closed in production until this is "true".
PUBLIC_SIGNUP=false

# Payment gateway keys are saved by Root Admin in Settings -> Payment gateway.
# There is no fallback secret in production, and simulate-payment is disabled.

# Optional AI workout/diet plans
OPENAI_API_KEY=
# AI provider for every product (decision D-15). Only 'openai' is built.
AI_PROVIDER=openai
# Model for Ask GymDesk and dashboard insights (cheap, fast). Plans use AI_PLAN_MODEL.
AI_MODEL=gpt-5.4-nano
AI_PLAN_MODEL=gpt-5.4-mini
# Optional: minimal | low | medium | high. Leave empty unless the chosen model needs it.
AI_REASONING_EFFORT=
# WhatsApp Cloud API (Meta). Business-initiated messages need approved templates.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Billing (GymDesk's own subscription invoices). Razorpay key id/secret are saved in
# Root Admin > Settings > Payment gateway, not here.
RAZORPAY_WEBHOOK_SECRET=
# Seller state. Buyers in the same state get CGST+SGST, all other states get IGST.
SELLER_STATE=Puducherry
INVOICE_PREFIX=AV
INVOICE_SELLER_NAME=Afra Ventures Pvt Ltd
INVOICE_SELLER_GSTIN=
INVOICE_SELLER_ADDRESS=
INVOICE_SAC=998431
INTERNAL_API_KEY=

# Email (owner billing reminders, welcome email). Any SMTP account works.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
PRODUCT_NAME=GymDesk
# Public app link used inside emails, e.g. https://app.example.com
CLIENT_URL=

# WhatsApp support chatbot (inbound). Webhook URL: /api/payments/whatsapp-webhook
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
