  "stats": {
    "today": {
      "label": "Today",
      "endpoint": "/summary",
      "refreshMs": 120000,
      "cards": [
        {
          "label": "Washes delivered",
          "path": "facts.jobsDelivered",
          "type": "number"
        },
        {
          "label": "Still open",
          "path": "facts.jobsOpen",
          "type": "number"
        },
        {
          "label": "Revenue",
          "path": "facts.revenue",
          "type": "money"
        },
        {
          "label": "Cash",
          "path": "facts.pay.cash",
          "type": "money"
        },
        {
          "label": "UPI",
          "path": "facts.pay.upi",
          "type": "money"
        },
        {
          "label": "Idle bay minutes",
          "path": "facts.idleMinutes",
          "type": "number"
        }
      ],
      "tables": [
        {
          "label": "Three things to do today (suggestions, nothing is sent)",
          "rows": "actions",
          "empty": "All clear. Nothing needs you right now.",
          "columns": [
            {
              "key": "text",
              "label": "What"
            },
            {
              "key": "reason",
              "label": "Why"
            }
          ]
        }
      ]
    },
    "predictions": {
      "label": "Estimates (not promises)",
      "endpoint": "/predictions",
      "cards": [
        {
          "label": "Next month, low",
          "path": "nextMonth.low",
          "type": "money"
        },
        {
          "label": "Next month, likely",
          "path": "nextMonth.expected",
          "type": "money"
        },
        {
          "label": "Next month, high",
          "path": "nextMonth.high",
          "type": "money"
        },
        {
          "label": "Passes ending in 14 days",
          "path": "renewals.count",
          "type": "number"
        },
        {
          "label": "Value if half renew",
          "path": "renewals.ifHalfRenew",
          "type": "money"
        }
      ],
      "tables": [
        {
          "label": "Customers who may stop coming",
          "rows": "lapseRisk",
          "empty": "Nobody looks at risk right now.",
          "columns": [
            {
              "key": "plate",
              "label": "Vehicle"
            },
            {
              "key": "name",
              "label": "Name"
            },
            {
              "key": "reason",
              "label": "Why"
            }
          ]
        }
      ]
    },
    "accounts": {
      "label": "Accounts (this month)",
      "endpoint": "/accounts/overview",
      "refreshMs": 120000,
      "cards": [
        {
          "label": "Revenue (after refunds)",
          "path": "pnl.revenue",
          "type": "money"
        },
        {
          "label": "Expenses",
          "path": "pnl.expenses",
          "type": "money"
        },
        {
          "label": "Attendant incentive",
          "path": "pnl.incentive",
          "type": "money"
        },
        {
          "label": "Profit",
          "path": "pnl.profit",
          "type": "money"
        },
        {
          "label": "Customers still owe",
          "path": "customerDueTotal",
          "type": "money"
        }
      ],
      "tables": [
        {
          "label": "Customers who owe you",
          "rows": "customerDues",
          "empty": "Nobody owes you right now.",
          "columns": [
            {
              "key": "plate",
              "label": "Vehicle"
            },
            {
              "key": "job",
              "label": "Job"
            },
            {
              "key": "day",
              "label": "Day",
              "type": "date"
            },
            {
              "key": "due",
              "label": "Owes",
              "type": "money"
            },
            {
              "key": "note",
              "label": "Note"
            }
          ]
        },
        {
          "label": "You owe suppliers",
          "rows": "supplierDues",
          "empty": "No unpaid supplier bills.",
          "columns": [
            {
              "key": "supplier",
              "label": "Supplier"
            },
            {
              "key": "due",
              "label": "Due",
              "type": "money"
            },
            {
              "key": "oldest",
              "label": "Since",
              "type": "date"
            }
          ]
        }
      ]
    },
    "leaks": {
      "label": "Discounts and voids (last 30 days)",
      "endpoint": "/leaks",
      "refreshMs": 300000,
      "tables": [
        {
          "label": "Discounts given by staff",
          "rows": "staffDiscounts",
          "empty": "No staff discounts in the last 30 days.",
          "columns": [
            {
              "key": "date",
              "label": "Day",
              "type": "date"
            },
            {
              "key": "count",
              "label": "How many",
              "type": "number"
            },
            {
              "key": "total",
              "label": "Worth",
              "type": "money"
            }
          ]
        },
        {
          "label": "Jobs cancelled after washing began",
          "rows": "voids",
          "empty": "None.",
          "columns": [
            {
              "key": "date",
              "label": "Day",
              "type": "date"
            },
            {
              "key": "count",
              "label": "How many",
              "type": "number"
            },
            {
              "key": "total",
              "label": "Worth",
              "type": "money"
            }
          ]
        }
      ]
    }
  },
  "resources": {
    "jobs": {
      "label": "Job board",
      "endpoint": "/jobs",
      "empty": "No open jobs. Add a vehicle that has arrived.",
      "columns": [
        {
          "key": "number",
          "label": "No."
        },
        {
          "key": "plate",
          "label": "Vehicle"
        },
        {
          "key": "klass",
          "label": "Class"
        },
        {
          "key": "total",
          "label": "Amount",
          "type": "money"
        },
        {
          "key": "state",
          "label": "State",
          "type": "pill"
        }
      ],
      "fields": [
        {
          "key": "plate",
          "label": "Number plate",
          "required": true,
          "max": 15
        },
        {
          "key": "klass",
          "label": "Class",
          "type": "select",
          "options": [
            "bike",
            "hatchback",
            "sedan",
            "suv",
            "other"
          ]
        }
      ],
      "actions": [
        {
          "label": "Start washing",
          "method": "POST",
          "path": "/jobs/:id/move",
          "body": {
            "to": "washing"
          },
          "when": {
            "key": "state",
            "equals": "waiting"
          }
        },
        {
          "label": "Ready",
          "method": "POST",
          "path": "/jobs/:id/move",
          "body": {
            "to": "ready"
          },
          "when": {
            "key": "state",
            "equals": "washing"
          }
        },
        {
          "label": "Cancel",
          "method": "POST",
          "path": "/jobs/:id/move",
          "body": {
            "to": "cancelled"
          },
          "when": {
            "key": "state",
            "equals": "waiting"
          }
        },
        {
          "label": "Cancel: customer left",
          "method": "POST",
          "path": "/jobs/:id/move",
          "body": {
            "to": "cancelled",
            "reason": "Customer left before the wash finished"
          },
          "when": {
            "key": "state",
            "equals": "washing"
          },
          "confirm": "Tap again to cancel this started job (the owner is told)"
        },
        {
          "label": "Cancel: problem with the vehicle",
          "method": "POST",
          "path": "/jobs/:id/move",
          "body": {
            "to": "cancelled",
            "reason": "Problem found with the vehicle"
          },
          "when": {
            "key": "state",
            "equals": "washing"
          },
          "confirm": "Tap again to cancel this started job (the owner is told)"
        },
        {
          "label": "Cancel: other (owner told)",
          "method": "POST",
          "path": "/jobs/:id/move",
          "body": {
            "to": "cancelled",
            "reason": "Cancelled after washing began, other reason"
          },
          "when": {
            "key": "state",
            "equals": "washing"
          },
          "confirm": "Tap again to cancel this started job (the owner is told)"
        },
        {
          "label": "Delivered, paid cash",
          "method": "POST",
          "path": "/jobs/:id/move",
          "body": {
            "to": "delivered",
            "payAllWith": "cash"
          },
          "when": {
            "key": "state",
            "equals": "ready"
          }
        },
        {
          "label": "Delivered, paid UPI",
          "method": "POST",
          "path": "/jobs/:id/move",
          "body": {
            "to": "delivered",
            "payAllWith": "upi"
          },
          "when": {
            "key": "state",
            "equals": "ready"
          }
        },
        {
          "label": "Delivered, paid card",
          "method": "POST",
          "path": "/jobs/:id/move",
          "body": {
            "to": "delivered",
            "payAllWith": "card"
          },
          "when": {
            "key": "state",
            "equals": "ready"
          }
        }
      ]
    },
    "vehicles": {
      "label": "Vehicles",
      "endpoint": "/vehicles",
      "empty": "No vehicles yet.",
      "columns": [
        {
          "key": "plate",
          "label": "Plate"
        },
        {
          "key": "klass",
          "label": "Class"
        },
        {
          "key": "ownerName",
          "label": "Owner"
        },
        {
          "key": "lastWash",
          "label": "Last wash",
          "type": "date"
        }
      ],
      "fields": [
        {
          "key": "plate",
          "label": "Number plate",
          "required": true,
          "max": 15
        },
        {
          "key": "klass",
          "label": "Class",
          "required": true,
          "type": "select",
          "options": [
            "bike",
            "hatchback",
            "sedan",
            "suv",
            "other"
          ]
        },
        {
          "key": "ownerName",
          "label": "Owner name",
          "max": 120
        },
        {
          "key": "ownerPhone",
          "label": "Mobile",
          "max": 10
        },
        {
          "key": "intervalDays",
          "label": "Usual gap in days",
          "type": "number",
          "min": 3,
          "max": 180
        }
      ]
    },
    "passes": {
      "label": "Monthly passes",
      "endpoint": "/passes",
      "empty": "No passes sold yet.",
      "columns": [
        {
          "key": "plate",
          "label": "Vehicle"
        },
        {
          "key": "used",
          "label": "Used",
          "type": "number"
        },
        {
          "key": "washes",
          "label": "Washes",
          "type": "number"
        },
        {
          "key": "endsOn",
          "label": "Ends",
          "type": "date"
        },
        {
          "key": "price",
          "label": "Price",
          "type": "money"
        }
      ],
      "fields": [
        {
          "key": "plate",
          "label": "Number plate",
          "required": true,
          "max": 15
        },
        {
          "key": "washes",
          "label": "Washes",
          "type": "number",
          "required": true,
          "min": 1,
          "max": 100
        },
        {
          "key": "price",
          "label": "Price",
          "type": "money",
          "required": true,
          "min": 0
        }
      ]
    },
    "attendants": {
      "label": "Attendants",
      "endpoint": "/attendants",
      "empty": "Add the people who wash.",
      "columns": [
        {
          "key": "name",
          "label": "Name"
        }
      ],
      "fields": [
        {
          "key": "name",
          "label": "Name",
          "required": true,
          "max": 80
        }
      ]
    },
    "closing": {
      "label": "Cash closing",
      "endpoint": "/cash-closing",
      "empty": "No day closed yet.",
      "columns": [
        {
          "key": "day",
          "label": "Day",
          "type": "date"
        },
        {
          "key": "expected",
          "label": "Bills say",
          "type": "money"
        },
        {
          "key": "declared",
          "label": "Counted",
          "type": "money"
        },
        {
          "key": "diff",
          "label": "Difference",
          "type": "money"
        },
        {
          "key": "flag",
          "label": "Check",
          "type": "pill"
        }
      ],
      "fields": [
        {
          "key": "declared",
          "label": "Cash counted",
          "type": "money",
          "required": true,
          "min": 0
        },
        {
          "key": "openingFloat",
          "label": "Cash at start of day",
          "type": "money",
          "min": 0
        }
      ]
    },
    "expenses": {
      "label": "Expenses",
      "endpoint": "/expenses",
      "empty": "No expenses noted this month.",
      "columns": [
        {
          "key": "day",
          "label": "Day",
          "type": "date"
        },
        {
          "key": "category",
          "label": "Type",
          "type": "pill"
        },
        {
          "key": "amount",
          "label": "Amount",
          "type": "money"
        },
        {
          "key": "supplier",
          "label": "Supplier"
        }
      ],
      "fields": [
        {
          "key": "category",
          "label": "Type",
          "required": true,
          "type": "select",
          "options": [
            "salary",
            "water",
            "electricity",
            "chemicals",
            "rent",
            "repairs",
            "other"
          ]
        },
        {
          "key": "amount",
          "label": "Amount",
          "type": "money",
          "required": true,
          "min": 1
        },
        {
          "key": "supplier",
          "label": "Supplier",
          "max": 80
        },
        {
          "key": "note",
          "label": "Note",
          "max": 120
        }
      ]
    },
    "audit": {
      "label": "Audit trail",
      "endpoint": "/audit",
      "empty": "Nothing recorded yet.",
      "readOnly": true,
      "columns": [
        {
          "key": "createdAt",
          "label": "When",
          "type": "date"
        },
        {
          "key": "action",
          "label": "What",
          "type": "pill"
        },
        {
          "key": "text",
          "label": "Details"
        }
      ],
      "fields": []
    }
  },
  "settings": {
    "discount": {
      "label": "Discounts",
      "endpoint": "/settings",
      "intro": "You decide who may give a discount. Every discount needs a reason, and you always see the ones your staff give in your daily list. You are never limited yourself.",
      "fields": [
        {
          "key": "discountRule.staff",
          "label": "Who may give a discount at billing?",
          "type": "select",
          "default": "limit",
          "options": [
            {
              "value": "limit",
              "label": "Staff, up to a limit"
            },
            {
              "value": "owner_only",
              "label": "Only me (the owner)"
            },
            {
              "value": "any",
              "label": "Any staff, any amount"
            }
          ]
        },
        {
          "key": "discountRule.maxPercent",
          "label": "Staff limit (percent of the bill)",
          "type": "number",
          "min": 0,
          "max": 100,
          "default": 10,
          "showWhen": {
            "key": "discountRule.staff",
            "equals": "limit"
          }
        }
      ]
    }
  }
}
