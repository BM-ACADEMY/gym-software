        {
          "key": "status",
          "label": "Status",
          "type": "pill"
        },
        {
          "key": "expiresOn",
          "label": "Expires",
          "type": "date"
        }
      ],
      "fields": [
        {
          "key": "customerId",
          "label": "Customer id (open the customer to copy it)",
