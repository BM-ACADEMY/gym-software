    },
    "forecast": {
      "label": "Estimates (not promises)",
      "endpoint": "/forecast/fees",
      "refreshMs": 300000,
      "cards": [
        {
          "label": "Fees that may come (estimate, without GST)",
          "path": "expectedFee",
          "type": "money"
        },
        {
          "label": "Open submissions counted",
          "path": "counted",
          "type": "number"
        },
        {
          "label": "Skipped (no fee terms or pay figure)",
          "path": "skipped",
          "type": "number"
        }
      ]
    },
    "mydata": {
      "label": "My data and account",
      "endpoint": "/account/close-request",
      "refreshMs": 600000,
      "cards": [
        {
          "label": "Close request",
          "path": "data.status",
          "type": "pill"
        },
        {
          "label": "Deleted after",
          "path": "data.deleteAfter",
          "type": "date"
        },
        {
          "label": "Waiting days if you ask to close",
          "path": "waitDays",
          "type": "number"
        }
      ],
      "downloads": [
        {
          "label": "Download all my agency data",
          "path": "/export",
          "filename": "hire-my-data.json"
        },
        {
          "label": "Download fees (CSV)",
          "path": "/export/fees.csv",
          "filename": "hire-fees.csv"
        },
        {
          "label": "Download clients (CSV)",
          "path": "/export/clients.csv",
          "filename": "hire-clients.csv"
        },
        {
          "label": "Download jobs (CSV)",
          "path": "/export/jobs.csv",
          "filename": "hire-jobs.csv"
        },
        {
          "label": "Download expenses (CSV)",
          "path": "/export/expenses.csv",
          "filename": "hire-expenses.csv"
        },
        {
          "label": "Download candidates (CSV)",
          "path": "/export/candidates.csv",
          "filename": "hire-candidates.csv"
        }
      ]
    }
  },
  "resources": {
    "entries": {
      "label": "Pipeline",
      "endpoint": "/entries",
      "readOnly": true,
      "empty": "No candidates are in a job yet.",
      "columns": [
        {
          "key": "candidate",
          "label": "Candidate"
        },
        {
          "key": "job",
          "label": "Job"
        },
        {
          "key": "stage",
          "label": "Stage",
          "type": "pill"
        },
        {
          "key": "stageAt",
          "label": "Since",
          "type": "date"
        },
        {
          "key": "clientDecision",
          "label": "Client says",
          "type": "pill"
        }
      ],
      "actions": [
        {
          "label": "Screened",
          "method": "POST",
          "path": "/entries/:id/move",
          "body": {
            "to": "screened"
          },
          "when": {
            "key": "stage",
            "equals": "sourced"
          }
        },
        {
          "label": "Send to client",
          "method": "POST",
          "path": "/entries/:id/move",
          "body": {
            "to": "submitted"
          },
          "when": {
            "key": "stage",
            "equals": "screened"
          }
        },
        {
          "label": "Interview",
          "method": "POST",
          "path": "/entries/:id/move",
          "body": {
            "to": "interview"
          },
          "when": {
            "key": "stage",
            "equals": "submitted"
          }
        },
        {
          "label": "Offer made",
          "method": "POST",
          "path": "/entries/:id/move",
          "body": {
            "to": "offer"
          },
          "when": {
            "key": "stage",
            "equals": "interview"
          }
        },
        {
          "label": "Joined",
          "method": "POST",
          "path": "/entries/:id/move",
          "body": {
            "to": "joined"
          },
          "when": {
            "key": "stage",
            "equals": "offer"
          },
          "confirm": "Tap again: candidate has joined"
        }
      ]
    },
    "candidates": {
      "label": "Candidates",
      "endpoint": "/candidates",
      "empty": "No candidates yet. Upload a resume or add one by hand.",
      "columns": [
        {
          "key": "name",
          "label": "Name"
        },
        {
          "key": "phone",
          "label": "Phone",
          "type": "phone"
        },
        {
          "key": "currentTitle",
          "label": "Title"
        },
        {
          "key": "experienceYears",
          "label": "Years",
          "type": "number"
        },
        {
          "key": "skills",
          "label": "Skills",
          "type": "tags"
        },
        {
          "key": "reviewed",
          "label": "Checked",
          "type": "bool"
        }
      ],
      "fields": [
        {
          "key": "name",
          "label": "Name",
          "required": true,
          "max": 120
        },
        {
          "key": "phone",
          "label": "Phone",
          "type": "phone"
        },
        {
          "key": "email",
          "label": "Email",
          "type": "email"
        },
        {
          "key": "location",
          "label": "Location",
          "max": 80
        },
        {
          "key": "currentTitle",
          "label": "Current title",
          "max": 80
        },
        {
          "key": "currentCompany",
          "label": "Current company",
          "max": 80
        },
        {
          "key": "experienceYears",
          "label": "Years of experience",
          "type": "number",
          "min": 0,
          "max": 60
        },
        {
          "key": "noticeDays",
          "label": "Notice period (days)",
          "type": "number",
          "min": 0,
          "max": 365
        },
        {
          "key": "expectedCtc",
          "label": "Expected pay per year",
          "type": "money",
          "min": 0
        },
        {
          "key": "skills",
          "label": "Skills (comma separated)",
          "type": "tags"
        }
      ],
      "actions": [
        {
          "label": "Get consent link",
          "method": "POST",
          "path": "/candidates/:id/consent-link",
          "done": "Link ready."
        },
        {
          "label": "Withdraw consent",
          "method": "POST",
          "path": "/candidates/:id/withdraw-consent",
          "confirm": "Tap again: stop contacting",
          "done": "Consent withdrawn."
        },
        {
          "label": "Remove personal details",
          "method": "POST",
          "path": "/candidates/:id/anonymise",
          "confirm": "Tap again: removes name, phone and email for good",
          "done": "Personal details removed."
        },
        {
          "label": "Delete",
          "method": "DELETE",
          "path": "/candidates/:id",
          "confirm": "Tap again to delete for good",
          "done": "Deleted."
        }
      ]
    },
