  "settings": {
    "discount": {
      "label": "Discounts",
      "endpoint": "/settings",
      "intro": "You decide who may give a discount. Every discount needs a reason, and you always see the ones your staff give in your daily list. You are never limited yourself.",
      "fields": [
        {
          "key": "discountRule.staff",
          "label": "Who may give a discount at billing?",
          "type": "select",
          "default": "limit",
          "options": [
            {
              "value": "limit",
              "label": "Staff, up to a limit"
            },
            {
              "value": "owner_only",
              "label": "Only me (the owner)"
            },
            {
              "value": "any",
              "label": "Any staff, any amount"
            }
          ]
        },
        {
          "key": "discountRule.maxPercent",
          "label": "Staff limit (percent of the bill)",
          "type": "number",
          "min": 0,
          "max": 100,
          "default": 10,
          "showWhen": {
            "key": "discountRule.staff",
            "equals": "limit"
          }
        }
      ]
    },
    "loyalty": {
      "label": "Loyalty points",
      "endpoint": "/settings",
      "intro": "Customers earn points on what they pay. Turn it on when you are ready. Points are used as a discount on the bill, and the discount rule still applies.",
      "fields": [
        {
          "key": "loyaltyRule.enabled",
          "label": "Give loyalty points",
          "type": "bool",
          "default": false
        },
        {
          "key": "loyaltyRule.earnPer100",
          "label": "Points for every Rs 100 paid",
          "type": "number",
          "min": 0,
          "max": 100,
          "default": 5
        },
        {
          "key": "loyaltyRule.minRedeem",
