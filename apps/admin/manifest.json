  "resources": {
    "today": {
      "label": "Today",
      "endpoint": "/marketing/today",
      "readOnly": true,
      "empty": "Nothing needs you today.",
      "columns": [
        {
          "key": "title",
          "label": "What"
        },
        {
          "key": "reason",
          "label": "Why"
        },
        {
          "key": "product",
          "label": "Product"
        },
        {
          "key": "channel",
          "label": "Channel",
          "type": "pill"
        },
        {
          "key": "due",
          "label": "Due",
          "type": "date"
        },
        {
          "key": "status",
          "label": "Status",
          "type": "pill"
        }
      ],
      "actions": [
        {
          "label": "Approve",
          "method": "POST",
          "path": "/marketing/items/:id/approve",
          "when": {
            "key": "status",
            "equals": "suggested"
          }
        },
        {
          "label": "Snooze 3 days",
          "method": "POST",
          "path": "/marketing/items/:id/snooze",
          "when": {
            "key": "status",
            "equals": "suggested"
          }
        },
        {
          "label": "Skip",
          "method": "POST",
          "path": "/marketing/items/:id/skip",
          "when": {
            "key": "status",
            "equals": "suggested"
          }
        },
        {
          "label": "Done",
          "method": "POST",
          "path": "/marketing/items/:id/done",
          "when": {
            "key": "status",
            "equals": "approved"
          }
        }
      ]
    },
    "todo": {
      "label": "Marketing to-do",
      "endpoint": "/marketing/items",
      "readOnly": true,
      "empty": "No items yet. The owner can press Find new suggestions.",
      "columns": [
        {
          "key": "title",
          "label": "What"
        },
        {
          "key": "aiTitle",
          "label": "Clearer wording (AI)"
        },
        {
          "key": "aiNote",
          "label": "Tip (AI)"
        },
        {
          "key": "owner",
          "label": "Owner",
          "type": "pill"
        },
        {
          "key": "channel",
          "label": "Channel",
          "type": "pill"
        },
        {
          "key": "priority",
          "label": "Priority",
          "type": "pill"
        },
        {
          "key": "due",
          "label": "Due",
          "type": "date"
        },
        {
          "key": "status",
          "label": "Status",
          "type": "pill"
        }
      ],
      "actions": [
        {
          "label": "Approve",
          "method": "POST",
          "path": "/marketing/items/:id/approve",
          "when": {
            "key": "status",
            "equals": "suggested"
          }
        },
        {
          "label": "Skip",
          "method": "POST",
          "path": "/marketing/items/:id/skip",
          "when": {
            "key": "status",
            "equals": "suggested"
          }
        },
        {
          "label": "Done",
          "method": "POST",
          "path": "/marketing/items/:id/done",
          "when": {
            "key": "status",
            "equals": "approved"
          }
        },
        {
          "label": "Bring back",
          "method": "POST",
          "path": "/marketing/items/:id/reopen",
          "when": {
            "key": "status",
            "equals": "skipped"
          }
        }
      ],
      "canAdd": true,
      "searchable": false,
      "toolbar": [
        {
          "label": "Find new suggestions",
          "method": "POST",
          "path": "/marketing/refresh",
          "done": "Checked."
        },
        {
          "label": "Write clearer wording (AI)",
          "method": "POST",
          "path": "/marketing/ai-wording",
          "done": "Done. Open items now show clearer wording where AI could write it."
        }
      ],
      "fields": [
        {
          "key": "title",
          "label": "What to do",
          "required": true
        },
        {
          "key": "reason",
          "label": "Why",
          "type": "textarea",
          "required": true
        },
        {
          "key": "channel",
          "label": "Channel",
          "type": "select",
          "required": true,
          "options": [
            "instagram",
            "youtube",
            "whatsapp_channel",
            "website",
            "email",
            "call",
            "other"
          ]
        },
        {
          "key": "priority",
          "label": "Priority",
          "type": "select",
          "options": [
            {
              "value": "decision_today",
              "label": "Decide today"
            },
            {
              "value": "this_week",
              "label": "This week"
            },
            {
              "value": "later",
              "label": "Later"
            }
          ]
        },
        {
          "key": "due",
          "label": "Due date",
          "type": "date"
        }
      ]
    },
