  "resources": {
    "expenses": {
      "label": "Expenses",
      "endpoint": "/expenses",
      "empty": "No expenses yet.",
      "columns": [
        {
          "key": "day",
          "label": "Day"
        },
        {
          "key": "category",
          "label": "Category",
          "type": "pill"
        },
        {
          "key": "amount",
          "label": "Amount",
          "type": "money"
        },
        {
          "key": "note",
          "label": "Note"
        }
      ],
      "fields": [
        {
          "key": "category",
          "label": "Category",
          "type": "select",
          "required": true,
          "options": [
            "rent",
            "salary",
            "electricity",
            "transport",
            "packaging",
            "repair",
            "tea_food",
            "other"
          ]
        },
        {
          "key": "amount",
          "label": "Amount (rupees)",
          "type": "money",
          "required": true,
          "min": 1
        },
        {
          "key": "note",
          "label": "Note",
          "type": "text",
          "max": 200
        }
      ]
    },
    "suppliers": {
      "label": "Suppliers",
      "endpoint": "/suppliers",
      "empty": "No suppliers yet.",
      "columns": [
        {
          "key": "name",
          "label": "Supplier"
        },
        {
          "key": "phone",
          "label": "Phone",
          "type": "phone"
        },
        {
          "key": "due",
          "label": "You owe",
          "type": "money"
        }
      ],
      "fields": [
        {
          "key": "name",
          "label": "Supplier name",
          "type": "text",
          "required": true,
          "max": 120
        },
        {
          "key": "phone",
          "label": "Phone",
          "type": "phone"
        }
      ]
    }
  },
  "settings": {
    "limits": {
      "label": "My settings",
      "endpoint": "/settings",
      "intro": "These are your own rules. Change them any time; no one else needs to be involved.",
      "numbers": [
        {
          "key": "defaultCreditLimit",
          "label": "Udhaar limit per customer (rupees, empty for none)",
          "min": 0
        },
        {
          "key": "overdueGraceDays",
          "label": "Udhaar overdue after (days)",
          "min": 1,
          "max": 365,
          "default": 15
        },
        {
          "key": "discountAlertPct",
          "label": "Warn me when a bill discount is above (%)",
          "min": 5,
          "max": 100,
          "default": 20
        },
        {
          "key": "deadStockDays",
          "label": "Slow stock after (days)",
          "min": 7,
          "max": 365,
          "default": 45
        },
        {
          "key": "festivalUplift",
          "label": "Festival order uplift (1 to 5)",
          "min": 1,
          "max": 5,
          "default": 1
        }
      ]
    }
  }
