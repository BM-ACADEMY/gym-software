# /etc/afra/admin.env  (owner afra, mode 600, NEVER in git). Variable names only: no values here.
# Written 13 Nov 2026 from apps/admin/server.js and apps/admin/src. Without the REQUIRED sign-in settings every route answers 503 (by design).
# PORT and NODE_ENV are set by deploy/ecosystem.config.js (5012; the code default 5010 clashes with Cloth).
ADMIN_SESSION_SECRET=          # REQUIRED  32+ random characters
ADMIN_MFA_KEY=                 # REQUIRED  32 random bytes, base64: openssl rand -base64 32 (two-step secrets are encrypted with it)
ADMIN_USERS_FILE=              # REQUIRED  path to the owner and staff list, e.g. /etc/afra/admin-users.json (mode 600)
ADMIN_AUDIT_FILE=              # REQUIRED  path to the audit log file, e.g. /var/log/afra/admin-audit.log
MONGODB_URI=                   # needed for the to-do, announcements, ideas and audit screens (its own database)
ADMIN_PRODUCTS=                # comma list of the products to read, e.g. gym,hire,salon,mart,dine,cloth,wash
ADMIN_URL_GYM=                 # one pair per product. ADMIN_URL_<PRODUCT>: on this same server use http://127.0.0.1:<port> (the only plain-http form the code accepts):
ADMIN_KEY_GYM=                 # gym 5000, hire 5006, salon 5007, mart 5008, dine 5009, cloth 5010, wash 5011. ADMIN_KEY_<PRODUCT> = that product's INTERNAL_API_KEY (24+ chars)
ADMIN_URL_HIRE=
ADMIN_KEY_HIRE=
ADMIN_URL_SALON=
ADMIN_KEY_SALON=
ADMIN_URL_MART=
ADMIN_KEY_MART=
ADMIN_URL_DINE=
ADMIN_KEY_DINE=
ADMIN_URL_CLOTH=
ADMIN_KEY_CLOTH=
ADMIN_URL_WASH=
ADMIN_KEY_WASH=
VAPID_PUBLIC_KEY=              # phone alerts for the owner (docs/ADMIN_PUSH_SETUP.md); optional
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=                 # mailto:privacy@afraventures.in style contact
PUSH_AUTORUN_MINUTES=          # 0 = only when the owner presses Send now
ADMIN_DAILY_AI_BUDGET_INR=     # optional AI spend stop shown in the cost screen
ADMIN_AI_RS_PER_MTOK_IN=
ADMIN_AI_RS_PER_MTOK_OUT=
# Note: Wash serves its counts at /api/internal/wash/admin-summary, the others at /api/internal/admin-summary (SA-18 aligns this).
