PORT=5000

# MongoDB Atlas connection string (mongodb+srv://...) — see DEPLOYMENT.md
MONGODB_URI=
# Separate database on the same cluster — the test suite connects here and
# drops it after each run. Never point this at your production database.
MONGODB_TEST_URI=

JWT_SECRET=
NODE_ENV=production

# 'demo' prints OTPs to the server console instead of sending real SMS/email —
# use 'live' in production once BULKSMS_API_URL (and SMTP env vars, if used)
# are configured below.
OTP_MODE=live
BULKSMS_API_URL=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# AI Plans (server/services/ai.js) — set this to have Claude generate real
# workout/diet plans; without it, AI Plans falls back to the built-in
# rule-based generator automatically.
ANTHROPIC_API_KEY=

# WhatsApp Cloud API (server/utils/whatsapp.js) — set both to send real
# WhatsApp notifications; without them, enabling WhatsApp in Admin Settings
# only logs messages instead of sending them.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
