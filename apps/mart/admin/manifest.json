          "required": true,
          "min": 1
        },
        {
          "key": "day",
          "label": "Day (empty means today)",
          "type": "date"
        },
        {
          "key": "note",
          "label": "Note",
          "type": "text",
          "max": 200
        }
      ]
    },
    "payroll": {
      "label": "Payslips (this month)",
      "endpoint": "/payroll",
      "readOnly": true,
      "empty": "Add staff first.",
      "intro": "Draft figures. You pay the staff yourself. A draft means some days are not marked.",
      "columns": [
        {
          "key": "name",
          "label": "Staff"
        },
        {
          "key": "payableDays",
          "label": "Payable days",
          "type": "number"
        },
        {
          "key": "gross",
          "label": "Pay for the days",
          "type": "money"
        },
        {
          "key": "advances",
          "label": "Advances",
          "type": "money"
        },
        {
          "key": "net",
          "label": "To pay",
          "type": "money"
        },
        {
          "key": "draft",
          "label": "Draft",
          "type": "bool"
        }
      ]
    },
    "team": {
      "label": "Team logins",
      "endpoint": "/team",
      "readOnly": true,
      "empty": "Only you so far.",
      "columns": [
        {
          "key": "name",
          "label": "Name"
        },
        {
          "key": "email",
          "label": "Email"
        },
        {
          "key": "role",
          "label": "Role",
          "type": "pill"
        },
        {
          "key": "isActive",
          "label": "Active",
          "type": "bool"
        }
      ],
      "actions": [
        {
          "label": "Switch off",
          "method": "POST",
          "path": "/team/:id/deactivate",
          "when": {
            "key": "isActive",
            "equals": true
          },
          "confirm": "Tap again to switch off"
        }
      ],
      "canAdd": true,
      "intro": "Cashier, stock keeper and manager logins. Add one with a name, email, role and a password of at least 8 characters, and tell the person their password yourself. Switch a login off any time.",
      "fields": [
        {
          "key": "name",
          "label": "Name",
          "type": "text",
          "required": true,
          "max": 120
        },
        {
          "key": "email",
          "label": "Email",
          "type": "email",
          "required": true
        },
        {
          "key": "role",
          "label": "Role",
          "type": "select",
          "required": true,
          "options": [
            {
              "value": "subadmin",
              "label": "Manager"
            },
            {
              "value": "cashier",
              "label": "Cashier"
            },
            {
              "value": "stockkeeper",
              "label": "Stock keeper"
            }
          ]
        },
        {
          "key": "password",
          "label": "Password (8 or more characters)",
          "type": "password",
          "min": 8,
          "max": 100,
          "required": true
        }
      ]
    },
    "upi": {
      "label": "UPI payment links",
      "endpoint": "/upi-links",
      "empty": "No link made yet.",
      "intro": "Set your UPI id under My settings first. We only make the link; the customer pays in their own UPI app. Check your UPI app or bank before you mark a link paid: we cannot see the money.",
      "columns": [
        {
          "key": "at",
          "label": "Made",
          "type": "date"
        },
        {
          "key": "amount",
          "label": "Amount",
          "type": "money"
        },
        {
          "key": "note",
          "label": "Note"
        },
        {
          "key": "link",
          "label": "Link"
        },
        {
          "key": "status",
          "label": "Status",
          "type": "pill"
        }
      ],
      "fields": [
        {
          "key": "amount",
          "label": "Amount (rupees)",
          "type": "money",
          "required": true,
          "min": 1
        },
        {
          "key": "note",
          "label": "Note (shown in the customer's UPI app)",
          "type": "text",
          "max": 40
        }
      ],
      "actions": [
        {
          "label": "Mark paid",
          "method": "POST",
          "path": "/upi-links/:id/paid",
          "when": {
            "key": "status",
            "equals": "created"
          },
          "confirm": "I checked: tap again"
        },
        {
          "label": "Cancel",
          "method": "POST",
          "path": "/upi-links/:id/cancel",
          "when": {
            "key": "status",
            "equals": "created"
          }
        }
      ]
    }
  },
  "settings": {
    "limits": {
      "label": "My settings",
      "endpoint": "/settings",
      "intro": "These are your own rules. Change them any time; no one else needs to be involved.",
      "numbers": [
        {
          "key": "defaultCreditLimit",
          "label": "Udhaar limit per customer (rupees, empty for none)",
