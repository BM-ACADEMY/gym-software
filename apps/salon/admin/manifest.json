  "stats": {
    "today": {
      "label": "Today",
      "endpoint": "/summary/today",
      "refreshMs": 120000,
      "cards": [
        {
          "label": "Bookings today",
          "path": "bookings.today",
          "type": "number"
        },
        {
          "label": "Waiting for you",
